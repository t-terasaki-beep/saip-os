# === 起動設定 ===
PORT=8787
NODE_ENV=development
DATABASE_PATH=./data/intake.db

# === AI解析プロバイダ ===
# mock = APIキー不要の決定論的解析（既定）/ claude = Anthropic Messages API
AI_PROVIDER=mock
ANTHROPIC_API_KEY=

# === 受信（チャネル単位の有効化。既定OFF、口座単位でも制御可） ===
CHATWORK_INGEST_ENABLED=false
GMAIL_INGEST_ENABLED=false

# === 送信（安全既定＝全体OFF。承認済み＋全体ON＋口座ONの3つが揃うまで送らない） ===
ALLOW_OUTBOUND_SEND=false

# === 期限超過チェック間隔（秒） ===
OVERDUE_CHECK_INTERVAL_SEC=300
