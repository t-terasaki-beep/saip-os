{
  "name": "ail-unified-intake",
  "version": "0.1.0",
  "private": true,
  "description": "高市さんグループ オンライン秘書OS — 統合受付・自動振り分けエンジン（受付→AI解析→担当割当→確認文案→進捗）",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --import tsx src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate": "tsx src/db.ts --migrate",
    "worker:once": "tsx src/jobs/worker.ts --once",
    "rehearsal": "tsx scripts/rehearsal.ts",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
